<Window x:Class="GuardianLink.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GuardianLink" Width="460" Height="480" WindowStartupLocation="CenterScreen">
  <StackPanel Margin="24">
    <TextBlock Text="GuardianLink" FontSize="26" FontWeight="SemiBold"/>
    <StackPanel x:Name="JoinPanel" Margin="0,12,0,0">
      <TextBlock TextWrapping="Wrap" Text="This app shares this computer's name, online status and battery level with your family organiser. It only shares while this window is open (minimise it, do not hide it), and you can leave the family at any time."/>
      <TextBlock Text="Pairing code from the parent" Margin="0,12,0,2"/><TextBox x:Name="CodeBox" MaxLength="8" CharacterCasing="Upper"/>
      <TextBlock Text="Device name" Margin="0,8,0,2"/><TextBox x:Name="NameBox"/>
      <CheckBox x:Name="Consent" Margin="0,12,0,0" Content="I understand and agree to share this information."/>
      <Button x:Name="JoinBtn" Content="Join family" Margin="0,12,0,0" Padding="8" Click="Join_Click"/>
    </StackPanel>
    <StackPanel x:Name="StatusPanel" Visibility="Collapsed" Margin="0,12,0,0">
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" Text="Connected."/>
      <Button Content="Leave family and stop sharing" Margin="0,12,0,0" Padding="8" Click="Leave_Click"/>
    </StackPanel>
    <TextBlock x:Name="Msg" Foreground="Firebrick" Margin="0,12,0,0" TextWrapping="Wrap"/>
  </StackPanel>
</Window>
